{
  "name": "basalt",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "basalt": "bin/basalt.js"
  },
  "scripts": {
    "start": "npm run build --silent && node bin/basalt.js --help",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "runtime-build:check": "node scripts/runtime-build-manifest.mjs --check",
    "authoring:anti-leak": "node scripts/check-authoring-generality.mjs",
    "architecture:check": "node scripts/check-package-boundaries.mjs && node scripts/check-visual-architecture.mjs && node scripts/check-union-exhaustiveness.mjs",
    "catalog:layout:check": "node scripts/check-catalog-layout.mjs",
    "catalog:workers:test": "node scripts/check-catalog-workers.mjs",
    "catalog:import-unity": "node scripts/import-unity-catalog.mjs",
    "neural:workers:test": "node scripts/check-neural-workers.mjs",
    "catalog:inventory": "node bin/basalt.js catalog inventory",
    "catalog:calibration": "node bin/basalt.js catalog calibration",
    "catalog:measure": "node bin/basalt.js catalog measure",
    "catalog:render": "node bin/basalt.js catalog render --workers 4",
    "catalog:metadata": "node bin/basalt.js catalog metadata prepare --scope smoke",
    "catalog:readiness": "node scripts/materialize-catalog-readiness.mjs",
    "catalog:qualification:pilot": "node scripts/materialize-catalog-qualification.mjs",
    "catalog:qualification:review": "node scripts/materialize-catalog-qualification-review.mjs",
    "catalog:qualification:finalize-descriptions": "node scripts/finalize-catalog-qualification.mjs",
    "catalog:qualification:queries": "node scripts/materialize-catalog-qualification-queries.mjs",
    "catalog:qualification:review-relevance": "node scripts/materialize-catalog-qualification-relevance-review.mjs",
    "catalog:qualification:finalize-relevance": "node scripts/finalize-catalog-qualification-relevance.mjs",
    "catalog:qualification:validator-cases": "node scripts/materialize-catalog-qualification-validator-cases.mjs",
    "catalog:qualification:review-validator": "node scripts/materialize-catalog-qualification-validator-review.mjs",
    "catalog:qualification:finalize-validator": "node scripts/finalize-catalog-qualification-validator.mjs",
    "catalog:metadata:import-reviewed": "npm run build --silent && node bin/basalt.js catalog metadata import-descriptions --producer-authority delegated_ai --producer-id codex-executor",
    "catalog:metadata:first-region": "npm run build --silent && node scripts/materialize-catalog-first-region-metadata.mjs && node bin/basalt.js catalog metadata ingest --batch .basalt/catalog/metadata/first-region-batch.json --output .basalt/catalog/metadata/first-region-set.json",
    "catalog:metadata:first-region:review-all": "npm run build --silent && node scripts/finalize-catalog-authored-metadata-review.mjs --batch .basalt/catalog/metadata/first-region-batch.json --output .basalt/catalog/metadata/first-region-review.json",
    "catalog:index:starting": "npm run build --silent && node bin/basalt.js catalog index",
    "catalog:context:pilot": "npm run build --silent && node scripts/materialize-catalog-context-pilot.mjs",
    "catalog:admission:outdoor-review": "node scripts/materialize-catalog-outdoor-review.mjs",
    "catalog:admission:outdoor-apply": "node scripts/apply-catalog-outdoor-review.mjs",
    "eval:tower": "npm run build --silent && node scripts/materialize-observation-tower.mjs",
    "eval:routes": "npm run build --silent && node scripts/materialize-route-corridor.mjs",
    "eval:catalog-first-use": "npm run build --silent && node scripts/materialize-catalog-first-use.mjs",
    "eval:catalog-first-use:upload": "npm run build --silent && node scripts/upload-catalog-assets.mjs",
    "eval:catalog-first-use:seal-bindings": "npm run build --silent && node scripts/seal-catalog-first-use-bindings.mjs",
    "eval:first-finished-region": "npm run build --silent && node scripts/materialize-first-finished-region.mjs",
    "catalog:commit": "node bin/basalt.js catalog commit",
    "catalog:validate": "node bin/basalt.js catalog validate",
    "catalog:seal": "node bin/basalt.js catalog seal",
    "asset-adaptation:semantics": "PYTHONDONTWRITEBYTECODE=1 \"/Applications/Blender.app/Contents/MacOS/Blender\" --background --factory-startup --disable-autoexec --offline-mode --python-exit-code 73 --python packages/roblox/workers/asset-adaptation/test_worker_semantics.py",
    "rojo:check": "node scripts/check-rojo-builds.mjs",
    "clean": "find packages -type d -name dist -prune -exec rm -rf {} + && find packages -name '*.tsbuildinfo' -delete && rm -rf dist",
    "build": "tsc -b tsconfig.json && node scripts/copy-test-fixtures.mjs && node scripts/runtime-build-manifest.mjs --write",
    "rebuild": "npm run clean && npm run build",
    "test": "npm run format:check && npm run lint && npm run authoring:anti-leak && npm run architecture:check && npm run rojo:check && npm run runtime-build:check && npm run catalog:layout:check && npm run catalog:workers:test && npm run neural:workers:test && node --test-concurrency=4 --test dist/test/*.test.js && npm run plugin:test",
    "plugin:test": "find packages/roblox/plugin/src -name '*.luau' -print0 | xargs -0 luau-compile --only-parse && node scripts/check-plugin-ui.mjs && lune run packages/roblox/plugin/test/verify-hardening.luau",
    "plugin:build": "node scripts/build-plugin.mjs",
    "build:all": "npm run build && npm run plugin:build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mermaid-js/mermaid-cli": "11.12.0",
    "@types/node": "^22.20.2",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.69.0"
  },
  "dependencies": {
    "zod": "4.5.4"
  }
}
