{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmitOnError": true,
    "declaration": true,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "packages/basalt-types/**/*.ts",
    "packages/contracts/**/*.ts",
    "packages/artifact-store/**/*.ts",
    "packages/authoring-graph/**/*.ts",
    "packages/spatial-core/**/*.ts",
    "packages/world-planning/**/*.ts",
    "packages/world-compiler/**/*.ts",
    "packages/asset-production/**/*.ts",
    "packages/asset-inspection/**/*.ts",
    "packages/asset-factory/**/*.ts",
    "packages/prepared-asset/**/*.ts",
    "packages/visual-catalog/**/*.ts",
    "packages/catalog-intelligence/**/*.ts",
    "packages/neural-asset/**/*.ts",
    "packages/reference-image/**/*.ts",
    "packages/region-composition/**/*.ts",
    "packages/studio-protocol/**/*.ts",
    "packages/studio-bridge/**/*.ts",
    "packages/cli/**/*.ts",
    "test/helpers/production-world-fixtures.ts",
    "test/helpers/grounding-evidence.ts",
    "test/world-compiler.test.ts",
    "test/world-family-resolver.test.ts",
    "test/world-factory-dispatch.test.ts",
    "test/hierarchical-world.test.ts",
    "test/studio-bridge.test.ts",
    "test/studio-bridge-cli.test.ts",
    "test/neural-family-factory.test.ts",
    "test/basalt-constraints.test.ts",
    "test/basalt-types.test.ts",
    "test/catalog-admission.test.ts",
    "test/asset-normalization.test.ts",
    "test/geometric-invariants.test.ts",
    "test/collision-pairing.test.ts",
    "test/authored-families.test.ts",
    "test/family-cards.test.ts",
    "test/family-proposals.test.ts",
    "test/trim-sheet.test.ts",
    "test/socket-extraction.test.ts",
    "test/road-assembly.test.ts",
    "test/scene-export.test.ts",
    "test/scene-upload.test.ts",
    "test/grounding.test.ts",
    "test/spacing.test.ts",
    "test/voxel-spots.test.ts",
    "test/voxel-field.test.ts",
    "test/bay-region.test.ts",
    "test/lot-subdivision.test.ts",
    "test/joint-sockets.test.ts",
    "test/wfc.test.ts",
    "test/kit-authoring.test.ts",
    "test/assembly.test.ts",
    "test/rooms.test.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
