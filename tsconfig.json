{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmitOnError": true,
    "declaration": true,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "packages/contracts/**/*.ts",
    "packages/artifact-store/**/*.ts",
    "packages/authoring-graph/**/*.ts",
    "packages/spatial-core/**/*.ts",
    "packages/world-planning/**/*.ts",
    "packages/world-compiler/**/*.ts",
    "packages/asset-production/**/*.ts",
    "packages/asset-inspection/**/*.ts",
    "packages/asset-factory/**/*.ts",
    "packages/prepared-asset/**/*.ts",
    "packages/visual-catalog/**/*.ts",
    "packages/catalog-intelligence/**/*.ts",
    "packages/neural-asset/**/*.ts",
    "packages/reference-image/**/*.ts",
    "packages/region-composition/**/*.ts",
    "packages/studio-protocol/**/*.ts",
    "packages/studio-bridge/**/*.ts",
    "packages/cli/**/*.ts",
    "test/helpers/production-world-fixtures.ts",
    "test/world-compiler.test.ts",
    "test/world-family-resolver.test.ts",
    "test/hierarchical-world.test.ts",
    "test/studio-bridge.test.ts",
    "test/neural-family-factory.test.ts",
    "test/basalt-constraints.test.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
