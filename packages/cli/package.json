    "@basalt/neural-asset": "*",
    "@basalt/roblox": "*",
    "@basalt/semantic-kernel": "*",
    "@basalt/world-compiler": "*",
    "@basalt/world-planning": "*",
    "@basalt/world-refinement": "*",
    "zod": "4.5.4"
  }
