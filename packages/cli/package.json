  "private": true,
  "type": "module",
  "exports": {
    "./world-authoring": {
      "types": "./dist/world-authoring.d.ts",
      "default": "./dist/world-authoring.js"
    },
    "./world-planner": {
      "types": "./dist/world-planner.d.ts",
